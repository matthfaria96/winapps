+
+/* Wine has a single local user, so the authenticated client is always the process user:
+ * impersonating the context means impersonating a copy of our own token. Servers such as
+ * Analysis Services (Power BI) require this after AcceptSecurityContext. */
+static SECURITY_STATUS WINAPI lsa_ImpersonateSecurityContext(CtxtHandle *context)
+{
+    HANDLE token;
+    SECURITY_STATUS status;
 
+    TRACE("%p\n", context);
+
+    if (!context) return SEC_E_INVALID_HANDLE;
+    if ((status = lsa_QuerySecurityContextToken(context, &token))) return status;
+    status = SetThreadToken(NULL, token) ? SEC_E_OK : SEC_E_NO_IMPERSONATION;
+    CloseHandle(token);
+    return status;
+}
+
+static SECURITY_STATUS WINAPI lsa_RevertSecurityContext(CtxtHandle *context)
+{
+    TRACE("%p\n", context);
+
+    if (!context) return SEC_E_INVALID_HANDLE;
+    return SetThreadToken(NULL, NULL) ? SEC_E_OK : SEC_E_INTERNAL_ERROR;
+}
