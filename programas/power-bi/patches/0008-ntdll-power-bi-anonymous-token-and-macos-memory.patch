--- a/dlls/ntdll/unix/security.c
+++ b/dlls/ntdll/unix/security.c
@@ -874,8 +874,29 @@
  */
 NTSTATUS WINAPI NtImpersonateAnonymousToken( HANDLE thread )
 {
-    FIXME( "(%p): stub\n", thread );
-    return STATUS_NOT_IMPLEMENTED;
+    /* Wine has no separate anonymous logon: impersonate a copy of the process token instead,
+     * so callers that impersonate briefly and then query the thread token (e.g. Analysis
+     * Services in Power BI) keep working. */
+    OBJECT_ATTRIBUTES attr;
+    SECURITY_QUALITY_OF_SERVICE qos;
+    HANDLE primary, token;
+    NTSTATUS status;
+
+    FIXME( "(%p): semi-stub\n", thread );
+
+    if ((status = NtOpenProcessToken( NtCurrentProcess(), TOKEN_DUPLICATE, &primary ))) return status;
+    qos.Length = sizeof(qos);
+    qos.ImpersonationLevel = SecurityImpersonation;
+    qos.ContextTrackingMode = SECURITY_STATIC_TRACKING;
+    qos.EffectiveOnly = FALSE;
+    InitializeObjectAttributes( &attr, NULL, 0, NULL, NULL );
+    attr.SecurityQualityOfService = &qos;
+    status = NtDuplicateToken( primary, TOKEN_IMPERSONATE | TOKEN_QUERY, &attr, FALSE, TokenImpersonation, &token );
+    NtClose( primary );
+    if (status) return status;
+    status = NtSetInformationThread( thread, ThreadImpersonationToken, &token, sizeof(token) );
+    NtClose( token );
+    return status;
 }
 
 
