+#endif
+#if defined(TASK_VM_INFO) && defined(TASK_VM_INFO_REV1_COUNT)
+    {
+        /* virtual_size counts reserved address space (tens of GB under Wine), which makes
+         * memory-aware programs believe they are out of memory; the committed/private
+         * memory Windows reports is closer to the physical footprint. */
+        task_vm_info_data_t vm;
+        mach_msg_type_number_t vmCount = TASK_VM_INFO_COUNT;
+
+        if (task_info( mach_task_self(), TASK_VM_INFO, (task_info_t)&vm, &vmCount ) == KERN_SUCCESS &&
+            vmCount >= TASK_VM_INFO_REV1_COUNT)
+        {
+            pvmi->PagefileUsage = vm.phys_footprint;
+            pvmi->PeakPagefileUsage = max( pvmi->PeakPagefileUsage, vm.phys_footprint );
+        }
     }
 #endif
 }
