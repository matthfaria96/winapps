+/***********************************************************************
+ *              process_has_visible_window
+ */
+static BOOL process_has_visible_window(DWORD pid)
+{
+    HWND hwnd;
+    DWORD owner;
+
+    for (hwnd = NtUserGetWindowRelative(NtUserGetDesktopWindow(), GW_CHILD); hwnd;
+         hwnd = NtUserGetWindowRelative(hwnd, GW_HWNDNEXT))
+    {
+        if (!(NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_VISIBLE)) continue;
+        owner = 0;
+        NtUserGetWindowThread(hwnd, &owner);
+        if (owner == pid) return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL name_is(const UNICODE_STRING *name, const char *ascii)
+{
+    USHORT i, len = name->Length / sizeof(WCHAR);
+
+    if (len != strlen(ascii)) return FALSE;
+    for (i = 0; i < len; i++)
+    {
+        WCHAR c = name->Buffer[i];
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (c != (unsigned char)ascii[i]) return FALSE;
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *              is_helper_process
+ *
+ * WinApps: a process is a "helper" when one of its (living) ancestors already
+ * shows windows, e.g. msedgewebview2.exe started by the host program.  Its
+ * windows then belong to the program's Mac app instead of getting a Dock icon
+ * of their own.  Processes started from Wine's explorer are not helpers.
+ */
+static BOOL is_helper_process(void)
+{
+    SYSTEM_PROCESS_INFORMATION *spi, *cur;
+    ULONG size = 0x40000, needed = 0, depth;
+    DWORD pid = HandleToULong(NtCurrentTeb()->ClientId.UniqueProcess), parent = 0;
+    NTSTATUS status;
+    BOOL ret = FALSE;
+    char *buf;
+
+    for (;;)
+    {
+        if (!(buf = malloc(size))) return FALSE;
+        status = NtQuerySystemInformation(SystemProcessInformation, buf, size, &needed);
+        if (status != STATUS_INFO_LENGTH_MISMATCH) break;
+        free(buf);
+        size = max(size * 2, needed + 0x1000);
+    }
+    if (status) goto done;
+
+#define FIND_PROCESS(id) \
+    for (cur = (SYSTEM_PROCESS_INFORMATION *)buf;; \
+         cur = (SYSTEM_PROCESS_INFORMATION *)((char *)cur + cur->NextEntryOffset)) \
+    { \
+        if (HandleToULong(cur->UniqueProcessId) == (id)) break; \
+        if (!cur->NextEntryOffset) { cur = NULL; break; } \
+    }
+
+    FIND_PROCESS(pid);
+    if (!cur) goto done;
+    parent = HandleToULong(cur->ParentProcessId);
+
+    for (depth = 0; parent && parent != pid && depth < 16; depth++)
+    {
+        FIND_PROCESS(parent);
+        if (!(spi = cur)) break;  /* parent is gone */
+        if (name_is(&spi->ProcessName, "explorer.exe")) break;
+        if (process_has_visible_window(parent))
+        {
+            ret = TRUE;
+            break;
+        }
+        parent = HandleToULong(spi->ParentProcessId);
+    }
+#undef FIND_PROCESS
+
+done:
+    free(buf);
+    TRACE("helper process: %d (ancestor %04x)\n", ret, ret ? (unsigned int)parent : 0);
+    return ret;
 }
 
 /***********************************************************************
+ *              update_helper_process
+ */
+static void update_helper_process(void)
+{
+    static BOOL regular;            /* once a normal app, always a normal app */
+    static DWORD last_check;
+    static BOOL helper;
+    DWORD now;
+
+    if (regular) return;
+    if (!group_helper_processes)
+    {
+        regular = TRUE;
+        macdrv_set_helper_process(0);
+        return;
+    }
+    now = NtGetTickCount();
+    if (!last_check || now - last_check > 1000)
+    {
+        helper = is_helper_process();
+        last_check = now ? now : 1;
+    }
+    macdrv_set_helper_process(helper);
+    if (!helper) regular = TRUE;
+}
