+
+/* A remote child's header is written by the process that owns the child, but its position and
+ * visibility also depend on ancestors owned by other processes (e.g. Chromium: the browser shows
+ * or moves Chrome_WidgetWin_1, the GPU process owns the "Intermediate D3D Window" below it).
+ * Whoever changes a child window therefore refreshes the headers of all descendants under the
+ * same root; the window functions used by remote_header_update() work across processes. */
+void macdrv_remote_refresh_descendants(HWND parent)
+{
+    HWND root, child, p;
+    char base[480], dir[700], path[800];
+    struct dirent *rent, *entry;
+    struct remote_header tmp;
+    unsigned long value;
+    DIR *rd, *d;
+    int fd;
+
+    if (!(NtUserGetWindowLongW(parent, GWL_STYLE) & WS_CHILD)) return;
+    if (!(root = NtUserGetAncestor(parent, GA_ROOT)) || root == parent) return;
+    macdrv_remote_surface_dir(base, sizeof(base), NULL);
+    if (!(rd = opendir(base))) return;
+    while ((rent = readdir(rd)))
+    {
+        if (rent->d_name[0] == '.') continue;
+        snprintf(dir, sizeof(dir), "%s/%s", base, rent->d_name);
+        if (!(d = opendir(dir))) continue;
+        while ((entry = readdir(d)))
+        {
+            if (!strstr(entry->d_name, ".surf") || sscanf(entry->d_name, "%08lx-", &value) != 1) continue;
+            child = (HWND)(ULONG_PTR)value;
+            for (p = child; p && p != parent && p != root; p = NtUserGetAncestor(p, GA_PARENT)) ;
+            if (p != parent) continue;
+            snprintf(path, sizeof(path), "%s/%s", dir, entry->d_name);
+            if ((fd = open(path, O_RDWR)) < 0) continue;
+            tmp.shared = mmap(NULL, sizeof(*tmp.shared), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+            close(fd);
+            if (tmp.shared == MAP_FAILED) continue;
+            snprintf(tmp.path, sizeof(tmp.path), "%s", path);
+            if (tmp.shared->magic == REMOTE_SURFACE_MAGIC) remote_header_update(&tmp, child);
+            munmap(tmp.shared, sizeof(*tmp.shared));
+        }
+        closedir(d);
+    }
+    closedir(rd);
 }
 
