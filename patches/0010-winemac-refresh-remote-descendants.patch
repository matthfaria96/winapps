+
+/* find a header file by name in any root directory (another process may have moved it) */
+static BOOL remote_header_find(const char *name, char *out, size_t size)
+{
+    char base[480];
+    struct dirent *entry;
+    struct stat st;
+    BOOL found = FALSE;
+    DIR *d;
+
+    macdrv_remote_surface_dir(base, sizeof(base), NULL);
+    if (!(d = opendir(base))) return FALSE;
+    while (!found && (entry = readdir(d)))
+    {
+        if (entry->d_name[0] == '.') continue;
+        snprintf(out, size, "%s/%s/%s", base, entry->d_name, name);
+        found = !stat(out, &st);
+    }
+    closedir(d);
+    return found;
+}
+
+/* windows can be moved to another root (SetParent; WebView2 hosts do this when they reuse a
+ * WebView in a dialog): keep the header in the directory of the current root, which is the
+ * one the owner of that root watches */
+static void remote_header_relocate(struct remote_header *hdr, HWND root)
+{
+    char dir[480], path[512];
+    const char *name = strrchr(hdr->path, '/');
+    size_t len;
+
+    if (!root || !name) return;
+    macdrv_remote_surface_dir(dir, sizeof(dir), root);
+    len = strlen(dir);
+    if (len == (size_t)(name - hdr->path) && !strncmp(dir, hdr->path, len)) return;
+    mkdir(dir, 0700);
+    snprintf(path, sizeof(path), "%s%s", dir, name);
+    if (rename(hdr->path, path) && !remote_header_find(name + 1, hdr->path, sizeof(hdr->path))) return;
+    if (strcmp(hdr->path, path) && rename(hdr->path, path)) return;
+    macdrv_dbg("remote header moved to %s\n", path);
+    memcpy(hdr->path, path, sizeof(path));
 }
 
