+                ev = macdrv_create_event(MOUSE_MOVED_ABSOLUTE, self);
+                ev->mouse_moved.x = floor(pt.x) - (m ? 0 : 4);
+                ev->mouse_moved.y = floor(pt.y);
+                ev->mouse_moved.drag = false;
+                ev->mouse_moved.time_ms = t + m * 40;
+                [queue postEvent:ev];
+                macdrv_release_event(ev);
+            }
+            /* web pages want to see the pointer over a button (hover) before it is clicked */
+            [self retain];
