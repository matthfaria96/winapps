 /***********************************************************************
+ *              measure_own_title_bar
+ *
+ * WinApps: height (in points) of the title bar a program draws itself, asking the program
+ * where its caption is (WM_NCHITTEST) down a few columns of the window.  0 = none found.
+ */
+static unsigned int measure_own_title_bar(HWND hwnd)
+{
+    static const int cols[] = {30, 45, 55, 65, 80};
+    UINT wdpi = NtUserGetDpiForWindow(hwnd), mdpi = NtUserGetWinMonitorDpi(hwnd, MDT_DEFAULT);
+    int best = 0, limit, i, y;
+    RECT r;
+
+    if (!wdpi || !mdpi || !NtUserGetWindowRect(hwnd, &r, wdpi)) return 0;
+    if (r.right - r.left < 200 || r.bottom - r.top < 100) return 0;
+    limit = min((r.bottom - r.top) / 3, (int)(160 * wdpi / 96));
+    for (i = 0; i < ARRAY_SIZE(cols); i++)
+    {
+        int x = r.left + (r.right - r.left) * cols[i] / 100, run = 0;
+        BOOL started = FALSE;
+        for (y = r.top; y < r.top + limit; y++)
+        {
+            LRESULT ht = send_message(hwnd, WM_NCHITTEST, 0, MAKELPARAM(x, y));
+            if (ht == HTTOP || ht == HTTOPLEFT || ht == HTTOPRIGHT || ht == HTBORDER)
+            {
+                if (started) break;
+                continue;
+            }
+            if (ht != HTCAPTION) break;
+            started = TRUE;
+            run = y - r.top + 1;
+        }
+        best = max(best, run);
+    }
+    if (!best) return 0;
+    {
+        CGRect mac = cgrect_mac_from_win(CGRectMake(0, 0, 10, (double)best * mdpi / wdpi));
+        int pts = (int)(mac.size.height + 0.99);
+        return min(max(pts, 1), 255);
+    }
+}
