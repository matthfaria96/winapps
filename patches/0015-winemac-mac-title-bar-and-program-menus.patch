+                    macdrv_event *b = macdrv_create_event(MOUSE_BUTTON, self);
+                    b->mouse_button.button = 0;
+                    b->mouse_button.pressed = (i == 0);
+                    b->mouse_button.x = floor(pt.x);
+                    b->mouse_button.y = floor(pt.y);
+                    b->mouse_button.time_ms = t + 600 + i * 60;
+                    [queue postEvent:b];
+                    macdrv_release_event(b);
+                }
+                [self release];
+            });
+            return;
+        }
+        [self wine_pressKeys:spec];
+    }
