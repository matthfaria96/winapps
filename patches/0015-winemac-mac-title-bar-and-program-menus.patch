+/* WinApps: icons the system symbols lack, drawn like them (thin strokes, template) */
+static NSImage *winapps_symbol(NSString *name, NSString *title)
+{
+    if ([name isEqualToString:@"@floppy"])
+    {
+        NSImage *img = [NSImage imageWithSize:NSMakeSize(16, 16) flipped:NO drawingHandler:^BOOL(NSRect r) {
+            NSBezierPath *p = [NSBezierPath bezierPath];
+            [[NSColor blackColor] set];
+            [p setLineWidth:1.25];
+            [p setLineJoinStyle:NSLineJoinStyleRound];
+            [p moveToPoint:NSMakePoint(2.6, 3.6)];              /* body with the cut corner */
+            [p curveToPoint:NSMakePoint(3.6, 2.6) controlPoint1:NSMakePoint(2.6, 3.0) controlPoint2:NSMakePoint(3.0, 2.6)];
+            [p lineToPoint:NSMakePoint(12.4, 2.6)];
+            [p curveToPoint:NSMakePoint(13.4, 3.6) controlPoint1:NSMakePoint(13.0, 2.6) controlPoint2:NSMakePoint(13.4, 3.0)];
+            [p lineToPoint:NSMakePoint(13.4, 11.0)];
+            [p lineToPoint:NSMakePoint(11.0, 13.4)];
+            [p lineToPoint:NSMakePoint(3.6, 13.4)];
+            [p curveToPoint:NSMakePoint(2.6, 12.4) controlPoint1:NSMakePoint(3.0, 13.4) controlPoint2:NSMakePoint(2.6, 13.0)];
+            [p closePath];
+            [p stroke];
+            p = [NSBezierPath bezierPathWithRoundedRect:NSMakeRect(5.0, 9.4, 5.2, 4.0) xRadius:0.6 yRadius:0.6];   /* shutter */
+            [p setLineWidth:1.25];
+            [p stroke];
+            p = [NSBezierPath bezierPathWithRoundedRect:NSMakeRect(4.6, 2.6, 6.8, 4.4) xRadius:0.8 yRadius:0.8];   /* label */
+            [p setLineWidth:1.25];
+            [p stroke];
+            return YES;
+        }];
+        [img setTemplate:YES];
+        img.accessibilityDescription = title;
+        return img;
+    }
+    return [NSImage imageWithSystemSymbolName:name accessibilityDescription:title];
+}
