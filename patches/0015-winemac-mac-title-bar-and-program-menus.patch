+static NSMenuItem *program_menu_item(NSString *title, NSString *keys)
+{
+    NSMenuItem *item = [[[NSMenuItem alloc] initWithTitle:title action:@selector(programMenuAction:) keyEquivalent:@""] autorelease];
+    NSArray *parts = [[keys lowercaseString] componentsSeparatedByString:@"+"];
+    NSString *key = [parts lastObject];
+    NSEventModifierFlags mask = 0;
+
+    item.representedObject = keys;
+    item.target = [WineApplicationController sharedController];
+    /* shown as the Mac shortcut: Ctrl is Command for the user (⌘C = Ctrl+C) */
+    if ([parts containsObject:@"ctrl"]) mask |= NSEventModifierFlagCommand;
+    if ([parts containsObject:@"shift"]) mask |= NSEventModifierFlagShift;
+    if ([parts containsObject:@"alt"]) mask |= NSEventModifierFlagOption;
+    if ([key isEqualToString:@"plus"]) key = @"+";
+    else if ([key isEqualToString:@"minus"]) key = @"-";
+    /* not the Mac's own ⌘H/⌘Q/⌘W/⌘M (hide, quit, close, minimize): only the menu item */
+    if (mask == NSEventModifierFlagCommand && [key length] == 1 && [@"hqwm" rangeOfString:key].location != NSNotFound)
+        return item;
+    if ([key length] == 1 && mask)
+    {
+        item.keyEquivalent = key;
+        item.keyEquivalentModifierMask = mask;
+    }
+    else if ([key length] >= 2 && [key characterAtIndex:0] == 'f')
+    {
+        int n = [[key substringFromIndex:1] intValue];
+        if (n >= 1 && n <= 12)
+        {
+            unichar c = NSF1FunctionKey + n - 1;
+            item.keyEquivalent = [NSString stringWithCharacters:&c length:1];
+            item.keyEquivalentModifierMask = mask;
+        }
+    }
+    return item;
+}
