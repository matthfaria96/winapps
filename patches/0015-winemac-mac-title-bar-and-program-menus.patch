+            [self retain];
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 2500 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                NSUInteger now = 0;
+                for (NSWindow *w in [NSApp windows]) if ([w isVisible]) now++;
+                if (now <= before) [self wine_runAction:plain];
