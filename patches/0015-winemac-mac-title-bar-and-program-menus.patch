+                                                                target:self action:@selector(buttonPressed:)];
+                    b.bordered = NO;
+                    b.toolTip = title;
+                    b.identifier = action;
+                    b.tag = 100 + side;   /* 100: left, 101: right */
+                    b.imagePosition = side == 0 ? NSImageOnly : NSImageLeading;
+                    b.contentTintColor = [NSColor secondaryLabelColor];
+                    [b sizeToFit];
+                    [self addSubview:b];
+                    [toolbar addObject:b];
+                }
+            }
+        }
