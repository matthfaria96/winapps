+    - (void) wine_pressKeys:(NSString*)keySpec
+    {
+        static const struct { const char *name; uint16_t code; } keys[] = {
+            {"a",0x00},{"s",0x01},{"d",0x02},{"f",0x03},{"h",0x04},{"g",0x05},{"z",0x06},{"x",0x07},
+            {"c",0x08},{"v",0x09},{"b",0x0B},{"q",0x0C},{"w",0x0D},{"e",0x0E},{"r",0x0F},{"y",0x10},
+            {"t",0x11},{"1",0x12},{"2",0x13},{"3",0x14},{"4",0x15},{"6",0x16},{"5",0x17},{"9",0x19},
+            {"7",0x1A},{"8",0x1C},{"0",0x1D},{"o",0x1F},{"u",0x20},{"i",0x22},{"p",0x23},{"l",0x25},
+            {"j",0x26},{"k",0x28},{"n",0x2D},{"m",0x2E},{"enter",0x24},{"tab",0x30},{"space",0x31},
+            {"plus",0x18},{"minus",0x1B},
+            {"backspace",0x33},{"esc",0x35},{"delete",0x75},{"home",0x73},{"end",0x77},{"pageup",0x74},
+            {"pagedown",0x79},{"left",0x7B},{"right",0x7C},{"down",0x7D},{"up",0x7E},
+            {"f1",0x7A},{"f2",0x78},{"f3",0x63},{"f4",0x76},{"f5",0x60},{"f6",0x61},{"f7",0x62},
+            {"f8",0x64},{"f9",0x65},{"f10",0x6D},{"f11",0x67},{"f12",0x6F},
+        };
+        NSString *spec = [keySpec lowercaseString];
+        uint16_t mods[3], key = 0xffff;
+        NSUInteger flags = 0, nmods = 0, i;
+
+        for (NSString *part in [spec componentsSeparatedByString:@"+"])
+        {
+            if ([part isEqualToString:@"ctrl"]) { mods[nmods++] = 0x3B; flags |= NSEventModifierFlagControl; }
+            else if ([part isEqualToString:@"shift"]) { mods[nmods++] = 0x38; flags |= NSEventModifierFlagShift; }
+            /* Alt: the driver turns the Command key into Alt (Option types characters on a Mac) */
+            else if ([part isEqualToString:@"alt"]) { mods[nmods++] = 0x37; flags |= NSEventModifierFlagCommand; }
+            else for (i = 0; i < sizeof(keys) / sizeof(keys[0]); i++)
+                if ([part isEqualToString:@(keys[i].name)]) key = keys[i].code;
+            if (nmods == 3) break;
+        }
+        if (key == 0xffff) return;
+        for (i = 0; i < nmods; i++) [self postKey:mods[i] pressed:YES modifiers:flags event:nil];
+        [self postKey:key pressed:YES modifiers:flags event:nil];
+        [self postKey:key pressed:NO modifiers:flags event:nil];
+        for (i = nmods; i-- > 0;) [self postKey:mods[i] pressed:NO modifiers:0 event:nil];
+    }
