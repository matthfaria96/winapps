+/* WinApps: a program icon on the white "squircle" plate of macOS app icons (Apple's 1024 grid:
+   824 plate, soft shadow); same drawing as winapps/icon-frame.swift */
+static NSImage *winapps_framed_icon(NSImage *icon)
+{
+    NSImage *framed = [NSImage imageWithSize:NSMakeSize(1024, 1024) flipped:NO drawingHandler:^BOOL(NSRect r) {
+        CGContextRef ctx = [[NSGraphicsContext currentContext] CGContext];
+        CGMutablePathRef path = CGPathCreateMutable();
+        CGColorSpaceRef cs = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+        CGFloat comps[] = {1, 1, 1, 1, 0.925, 0.93, 0.945, 1}, locs[] = {0, 1};
+        CGGradientRef grad = CGGradientCreateWithColorComponents(cs, comps, locs, 2);
+        NSSize sz = icon.size;
+        CGFloat side, scale;
+        int i;
+
+        for (i = 0; i < 1440; i++)   /* superellipse |x|^5 + |y|^5 = 1 */
+        {
+            double t = i / 1440.0 * 2 * M_PI, c = cos(t), s = sin(t);
+            CGFloat x = 512 + 412 * copysign(pow(fabs(c), 0.4), c), y = 512 + 412 * copysign(pow(fabs(s), 0.4), s);
+            if (i) CGPathAddLineToPoint(path, NULL, x, y); else CGPathMoveToPoint(path, NULL, x, y);
+        }
+        CGPathCloseSubpath(path);
+
+        CGContextSaveGState(ctx);
+        CGContextSetShadowWithColor(ctx, CGSizeMake(0, -10), 24, [[NSColor colorWithWhite:0 alpha:0.28] CGColor]);
+        CGContextAddPath(ctx, path);
+        CGContextSetGrayFillColor(ctx, 1, 1);
+        CGContextFillPath(ctx);
+        CGContextRestoreGState(ctx);
+
+        CGContextSaveGState(ctx);
+        CGContextAddPath(ctx, path);
+        CGContextClip(ctx);
+        CGContextDrawLinearGradient(ctx, grad, CGPointMake(0, 924), CGPointMake(0, 100), 0);
+        CGContextRestoreGState(ctx);
+
+        CGContextAddPath(ctx, path);
+        CGContextSetGrayStrokeColor(ctx, 0, 0.10);
+        CGContextSetLineWidth(ctx, 2);
+        CGContextStrokePath(ctx);
+
+        side = 560;
+        CGContextSetInterpolationQuality(ctx, kCGInterpolationHigh);
+        if (MAX(sz.width, sz.height) > 0 && MAX(sz.width, sz.height) < 128)
+        {
+            side = floor(560 / MAX(sz.width, sz.height)) * MAX(sz.width, sz.height);   /* small icons: whole factor */
+            CGContextSetInterpolationQuality(ctx, kCGInterpolationNone);
+        }
+        scale = side / MAX(1, MAX(sz.width, sz.height));
+        CGContextSaveGState(ctx);
+        CGContextSetShadowWithColor(ctx, CGSizeMake(0, -4), 10, [[NSColor colorWithWhite:0 alpha:0.18] CGColor]);
+        [icon drawInRect:NSMakeRect((1024 - sz.width * scale) / 2, (1024 - sz.height * scale) / 2, sz.width * scale, sz.height * scale)
+                fromRect:NSZeroRect operation:NSCompositingOperationSourceOver fraction:1];
+        CGContextRestoreGState(ctx);
+
+        CGGradientRelease(grad);
+        CGColorSpaceRelease(cs);
+        CGPathRelease(path);
+        return YES;
+    }];
+    return framed;
+}
