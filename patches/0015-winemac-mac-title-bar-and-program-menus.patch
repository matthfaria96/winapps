+@implementation WineTrafficLight
+
+    - (BOOL) isFlipped { return NO; }
+
+    - (void) drawRect:(NSRect)dirty
+    {
+        static const CGFloat fill[3][3] = {{1.0, 0.373, 0.341}, {0.996, 0.737, 0.180}, {0.157, 0.784, 0.251}};
+        static const CGFloat edge[3][3] = {{0.886, 0.275, 0.247}, {0.882, 0.631, 0.086}, {0.071, 0.675, 0.157}};
+        static const CGFloat glyph[3][3] = {{0.30, 0.0, 0.0}, {0.60, 0.34, 0.0}, {0.0, 0.40, 0.0}};
+        WineTrafficLights *group = (WineTrafficLights *)[self superview];
+        BOOL hover = [group isKindOfClass:[WineTrafficLights class]] && group->inside;
+        BOOL active = [[self window] isKeyWindow] || [[self window] isMainWindow] || hover;
+        BOOL dark = [[[self effectiveAppearance] bestMatchFromAppearancesWithNames:@[NSAppearanceNameAqua, NSAppearanceNameDarkAqua]]
+                        isEqualToString:NSAppearanceNameDarkAqua];
+        NSInteger k = MIN(MAX([self tag], 0), 2);
+        NSRect b = [self bounds];
+        CGFloat d = 12, x = NSMidX(b) - d / 2, y = NSMidY(b) - d / 2;
+        NSBezierPath *circle = [NSBezierPath bezierPathWithOvalInRect:NSMakeRect(x + 0.25, y + 0.25, d - 0.5, d - 0.5)];
+        CGFloat shade = [self isHighlighted] ? 0.82 : 1.0;
+
+        if (![self isEnabled] || !active)
+        {
+            [[NSColor colorWithWhite:(dark ? 0.32 : 0.82) alpha:1] setFill];
+            [[NSColor colorWithWhite:(dark ? 0.26 : 0.72) alpha:1] setStroke];
+        }
+        else
+        {
+            [[NSColor colorWithSRGBRed:fill[k][0] * shade green:fill[k][1] * shade blue:fill[k][2] * shade alpha:1] setFill];
+            [[NSColor colorWithSRGBRed:edge[k][0] green:edge[k][1] blue:edge[k][2] alpha:1] setStroke];
+        }
+        [circle fill];
+        [circle setLineWidth:0.5];
+        [circle stroke];
+
+        if (hover && [self isEnabled])
+        {
+            NSBezierPath *g = [NSBezierPath bezierPath];
+            CGFloat cx = NSMidX(b), cy = NSMidY(b), r = 2.9;
+            [[NSColor colorWithSRGBRed:glyph[k][0] green:glyph[k][1] blue:glyph[k][2] alpha:0.85] setStroke];
+            [g setLineWidth:1.15];
+            [g setLineCapStyle:NSLineCapStyleRound];
+            if (k == 0)
+            {
+                [g moveToPoint:NSMakePoint(cx - r, cy - r)]; [g lineToPoint:NSMakePoint(cx + r, cy + r)];
+                [g moveToPoint:NSMakePoint(cx - r, cy + r)]; [g lineToPoint:NSMakePoint(cx + r, cy - r)];
+            }
+            else
+            {
+                [g moveToPoint:NSMakePoint(cx - r - 0.6, cy)]; [g lineToPoint:NSMakePoint(cx + r + 0.6, cy)];
+                if (k == 2) { [g moveToPoint:NSMakePoint(cx, cy - r - 0.6)]; [g lineToPoint:NSMakePoint(cx, cy + r + 0.6)]; }
+            }
+            [g stroke];
+        }
+    }
+
+@end
