+/* WinApps: without a .app of its own, the process would show the engine's binary name in the
+   Dock, Cmd-Tab and the menu bar: register the program's name with Launch Services instead */
+static void name_process_after_program(void)
+{
+    typedef CFTypeRef (*get_asn_t)(void);
+    typedef OSStatus (*set_info_t)(int, CFTypeRef, CFStringRef, CFTypeRef, CFDictionaryRef *);
+    static void *ls;
+    get_asn_t get_asn;
+    set_info_t set_info;
+    CFStringRef *key;
+
+    if (!program_name || [[NSBundle mainBundle] objectForInfoDictionaryKey:@"CFBundleIconFile"]) return;
+    [[NSProcessInfo processInfo] setProcessName:program_name];
+    if (!ls) ls = dlopen("/System/Library/Frameworks/CoreServices.framework/CoreServices", RTLD_LAZY);
+    if (!ls) return;
+    get_asn = (get_asn_t)dlsym(ls, "_LSGetCurrentApplicationASN");
+    set_info = (set_info_t)dlsym(ls, "_LSSetApplicationInformationItem");
+    key = (CFStringRef *)dlsym(ls, "_kLSDisplayNameKey");
+    if (get_asn && set_info && key && *key)
+    {
+        CFTypeRef asn = get_asn();
+        if (asn) set_info(-2 /* kLSDefaultSessionID */, asn, *key, (CFStringRef)program_name, NULL);
+    }
+}
