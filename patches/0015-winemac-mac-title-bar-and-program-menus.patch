+        label = [[NSTextField labelWithString:@""] retain];
+        label.font = [NSFont titleBarFontOfSize:0];
+        label.alignment = NSTextAlignmentCenter;
+        label.lineBreakMode = NSLineBreakByTruncatingMiddle;
+        label.textColor = [NSColor labelColor];
