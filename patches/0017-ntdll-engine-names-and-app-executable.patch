 DECLSPEC_EXPORT void __wine_main( int argc, char *argv[] )
 {
+    /* WinApps: a program's .app runs the engine as its own executable.  Launch Services
+     * passes no arguments; the program and its settings come from the app's LSEnvironment. */
+    const char *program = getenv( "WINAPPS_PROGRAM" );
+    const char *lang = getenv( "WINAPPS_LANG" );
+    const char *path_first = getenv( "WINAPPS_PATH" );
+
+    /* the user's macOS language, whatever the process that asked to open the app had */
+    if (lang && *lang) { setenv( "LANG", lang, 1 ); unsetenv( "LC_ALL" ); }
+    /* the engine's tools (ntlm_auth…) first: Launch Services keeps the caller's PATH */
+    if (path_first && *path_first)
+    {
+        const char *path = getenv( "PATH" );
+        char *new_path = malloc( strlen( path_first ) + (path ? strlen( path ) : 0) + 2 );
+        if (new_path)
+        {
+            strcpy( new_path, path_first );
+            if (path && *path) { strcat( new_path, ":" ); strcat( new_path, path ); }
+            setenv( "PATH", new_path, 1 );
+            free( new_path );
+        }
+        unsetenv( "WINAPPS_PATH" );
+    }
+    if (argc <= 1 && program && *program)
+    {
+        static char *app_argv[3];
+        const char *log = getenv( "WINAPPS_LOG" );
+        char *dir = strdup( program ), *slash = strrchr( dir, '/' );
+
+        if (slash && slash != dir) { *slash = 0; if (chdir( dir )) { /* keep the current directory */ } }
+        free( dir );
+        if (log && *log)
+        {
+            int fd = open( log, O_WRONLY | O_CREAT | O_TRUNC, 0644 );
+            if (fd >= 0) { dup2( fd, 1 ); dup2( fd, 2 ); close( fd ); }
+        }
+        app_argv[0] = argv[0];
+        app_argv[1] = strdup( program );
+        app_argv[2] = NULL;
+        argc = 2;
+        argv = app_argv;
+        unsetenv( "WINAPPS_PROGRAM" );   /* not for the processes it starts */
+        unsetenv( "WINAPPS_LOG" );
+    }
+
     main_argc = argc;
     main_argv = argv;
 
