 /***********************************************************************
+ *              macdrv_window_follow_mouse
+ *
+ * WinApps: a maximized window was restored by dragging its title bar.  Keep it under the
+ * mouse (at the same relative spot) until the button is released, then snap like macOS
+ * tiling / Windows: top of the screen -> maximized, left or right edge -> half.
+ */
+void macdrv_window_follow_mouse(WineWindow *window, double frac_x, double frac_y)
+{
+    [window retain];
+    OnMainThreadAsync(^{
+        __block id monitor = nil;
+        /* frac_x < 0: keep the mouse where it is now on the window (normal drag) */
+        NSPoint m0 = [NSEvent mouseLocation];
+        NSRect f0 = window.frame;
+        double fx = frac_x >= 0 ? frac_x : (m0.x - NSMinX(f0)) / MAX(1, NSWidth(f0));
+        CGFloat fixed_off_y = NSMaxY(f0) - m0.y;
+        void (^place)(void) = ^{
+            NSPoint m = [NSEvent mouseLocation];
+            NSRect f = window.frame;
+            NSScreen *screen = window.screen ?: [NSScreen mainScreen];
+            CGFloat off_y = frac_x >= 0 ? MIN(frac_y * NSHeight(screen.visibleFrame), NSHeight(f) / 2) : fixed_off_y;
+            [window setFrameTopLeftPoint:NSMakePoint(m.x - fx * NSWidth(f), m.y + off_y)];
+        };
+
+        place();
+        monitor = [NSEvent addLocalMonitorForEventsMatchingMask:NSEventMaskLeftMouseDragged | NSEventMaskLeftMouseUp
+                                                        handler:^NSEvent *(NSEvent *event) {
+            place();
+            if (event.type == NSEventTypeLeftMouseUp)
+            {
+                NSPoint m = [NSEvent mouseLocation];
+                NSScreen *s = nil;
+                for (NSScreen *sc in [NSScreen screens]) if (NSMouseInRect(m, sc.frame, NO)) s = sc;
+                if (s)
+                {
+                    NSRect vf = s.visibleFrame, sf = s.frame;
+                    if (m.y >= NSMaxY(vf) - 1)
+                    {
+                        macdrv_event *ev = macdrv_create_event(WINDOW_MAXIMIZE_REQUESTED, window);
+                        [window.queue postEvent:ev];
+                        macdrv_release_event(ev);
+                    }
+                    else if (m.x <= NSMinX(sf) + 1)
+                        [window setFrame:NSMakeRect(NSMinX(vf), NSMinY(vf), NSWidth(vf) / 2, NSHeight(vf)) display:YES];
+                    else if (m.x >= NSMaxX(sf) - 2)
+                        [window setFrame:NSMakeRect(NSMidX(vf), NSMinY(vf), NSWidth(vf) / 2, NSHeight(vf)) display:YES];
+                }
+                [NSEvent removeMonitor:monitor];
+                [window release];
+            }
+            return event;
+        }];
+    });
+}
