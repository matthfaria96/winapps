diff -ruN a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
--- a/dlls/winemac.drv/window.c	2026-11-07 10:55:27
+++ b/dlls/winemac.drv/window.c	2026-11-07 10:55:54
@@ -2197,6 +2197,150 @@
 
 
 /***********************************************************************
+ *              Native macOS menu bar (NativeMenuBar option)
+ *
+ * The Cocoa side asks for a snapshot of the window's menu and shows it in the
+ * macOS menu bar; picking an item there posts WM_COMMAND to the window.
+ */
+enum
+{
+    MENU_SNAPSHOT_SEPARATOR = 1,
+    MENU_SNAPSHOT_DISABLED  = 2,
+    MENU_SNAPSHOT_CHECKED   = 4,
+    MENU_SNAPSHOT_RADIO     = 8,
+};
+
+static HMENU window_menu(HWND hwnd)
+{
+    if (!hwnd || (NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_CHILD)) return 0;
+    return (HMENU)NtUserGetWindowLongPtrW(hwnd, GWLP_ID);
+}
+
+static void dict_set_number(CFMutableDictionaryRef dict, CFStringRef key, int value)
+{
+    CFNumberRef num = CFNumberCreate(NULL, kCFNumberIntType, &value);
+    CFDictionarySetValue(dict, key, num);
+    CFRelease(num);
+}
+
+/* "&Open...\tCtrl+O" -> title "Open..." and shortcut "Ctrl+O" ("&&" is a literal '&') */
+static void dict_set_menu_text(CFMutableDictionaryRef dict, const WCHAR *text, UINT len)
+{
+    WCHAR title[256];
+    UINT i, n = 0, tab = len;
+    CFStringRef str;
+
+    for (i = 0; i < len; i++) if (text[i] == '\t' || text[i] == '\b') { tab = i; break; }
+    for (i = 0; i < tab && n < ARRAY_SIZE(title); i++)
+    {
+        if (text[i] == '&')
+        {
+            if (i + 1 < tab && text[i + 1] == '&') title[n++] = '&', i++;
+            continue;
+        }
+        title[n++] = text[i];
+    }
+    str = CFStringCreateWithCharacters(NULL, (const UniChar *)title, n);
+    CFDictionarySetValue(dict, CFSTR("t"), str);
+    CFRelease(str);
+    if (tab + 1 < len)
+    {
+        str = CFStringCreateWithCharacters(NULL, (const UniChar *)text + tab + 1, len - tab - 1);
+        CFDictionarySetValue(dict, CFSTR("k"), str);
+        CFRelease(str);
+    }
+}
+
+static CFArrayRef copy_menu_items(HWND hwnd, HMENU menu, int depth, BOOL init)
+{
+    CFMutableArrayRef array = CFArrayCreateMutable(NULL, 0, &kCFTypeArrayCallBacks);
+    INT_PTR count = NtUserGetMenuItemCount(menu);
+    int i;
+
+    for (i = 0; i < count && i < 512; i++)
+    {
+        WCHAR text[256];
+        MENUITEMINFOW mii = { sizeof(mii) };
+        CFMutableDictionaryRef dict;
+        int flags = 0;
+
+        mii.fMask = MIIM_FTYPE | MIIM_STATE | MIIM_ID | MIIM_SUBMENU | MIIM_STRING;
+        mii.dwTypeData = text;
+        mii.cch = ARRAY_SIZE(text);
+        if (!NtUserThunkedMenuItemInfo(menu, i, MF_BYPOSITION, NtUserGetMenuItemInfoW, &mii, NULL))
+            continue;
+
+        if (mii.fType & MFT_SEPARATOR) flags |= MENU_SNAPSHOT_SEPARATOR;
+        if (mii.fState & MFS_DISABLED) flags |= MENU_SNAPSHOT_DISABLED;
+        if (mii.fState & MFS_CHECKED) flags |= MENU_SNAPSHOT_CHECKED;
+        if (mii.fType & MFT_RADIOCHECK) flags |= MENU_SNAPSHOT_RADIO;
+
+        dict = CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks,
+                                         &kCFTypeDictionaryValueCallBacks);
+        dict_set_number(dict, CFSTR("f"), flags);
+        dict_set_number(dict, CFSTR("i"), mii.wID);
+        if (!(flags & MENU_SNAPSHOT_SEPARATOR) && !(mii.fType & MFT_BITMAP))
+            dict_set_menu_text(dict, text, min(mii.cch, ARRAY_SIZE(text) - 1));
+
+        if (mii.hSubMenu && depth < 6)
+        {
+            CFArrayRef sub;
+            if (init) send_message(hwnd, WM_INITMENUPOPUP, (WPARAM)mii.hSubMenu, MAKELPARAM(i, FALSE));
+            sub = copy_menu_items(hwnd, mii.hSubMenu, depth + 1, init);
+            CFDictionarySetValue(dict, CFSTR("s"), sub);
+            CFRelease(sub);
+        }
+        CFArrayAppendValue(array, dict);
+        CFRelease(dict);
+    }
+    return array;
+}
+
+/***********************************************************************
+ *              query_menu_snapshot
+ *
+ * Handler for QUERY_MENU_SNAPSHOT query.
+ */
+bool query_menu_snapshot(HWND hwnd, macdrv_query *query)
+{
+    HMENU menu = window_menu(hwnd);
+    int top = query->menu.top;
+
+    TRACE("hwnd %p menu %p top %d\n", hwnd, menu, top);
+    query->menu.items = NULL;
+    if (!menu || (INT_PTR)NtUserGetMenuItemCount(menu) <= 0) return true;  /* no menu: empty result */
+
+    if (top >= 0)
+    {
+        /* let the program update checks/enabled states, as when its menu opens */
+        MENUITEMINFOW mii = { sizeof(mii) };
+        mii.fMask = MIIM_SUBMENU;
+        if (!NtUserThunkedMenuItemInfo(menu, top, MF_BYPOSITION, NtUserGetMenuItemInfoW, &mii, NULL) ||
+            !mii.hSubMenu)
+            return false;
+        send_message(hwnd, WM_INITMENU, (WPARAM)menu, 0);
+        send_message(hwnd, WM_INITMENUPOPUP, (WPARAM)mii.hSubMenu, MAKELPARAM(top, FALSE));
+        query->menu.items = copy_menu_items(hwnd, mii.hSubMenu, 1, TRUE);
+    }
+    else
+        query->menu.items = copy_menu_items(hwnd, menu, 0, FALSE);
+    return true;
+}
+
+/***********************************************************************
+ *              query_menu_command
+ *
+ * Handler for QUERY_MENU_COMMAND query.
+ */
+bool query_menu_command(HWND hwnd, macdrv_query *query)
+{
+    TRACE("hwnd %p command %u\n", hwnd, query->menu.command);
+    if (!window_menu(hwnd)) return false;
+    return NtUserPostMessage(hwnd, WM_COMMAND, MAKEWPARAM(query->menu.command, 0), 0);
+}
+
+
+/***********************************************************************
  *              init_win_context
  */
 void init_win_context(void)
