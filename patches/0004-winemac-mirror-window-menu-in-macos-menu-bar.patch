diff -ruN a/dlls/winemac.drv/cocoa_app.m b/dlls/winemac.drv/cocoa_app.m
--- a/dlls/winemac.drv/cocoa_app.m	2026-11-07 10:55:27
+++ b/dlls/winemac.drv/cocoa_app.m	2026-11-07 10:56:38
@@ -2731,3 +2731,246 @@
 
     return ret;
 }
+
+
+/*
+ * ---------- Native macOS menu bar (NativeMenuBar option) ----------
+ *
+ * Mirrors the menu of the key Wine window into the macOS menu bar, between the
+ * application menu and the Window menu. Menus are refreshed (with WM_INITMENUPOPUP)
+ * each time one opens; picking an item posts WM_COMMAND. Shortcuts are shown but
+ * left to the program itself, so they never fire twice.
+ */
+enum { PROGRAM_MENU_SEPARATOR = 1, PROGRAM_MENU_DISABLED = 2, PROGRAM_MENU_CHECKED = 4 };
+
+@interface WineProgramMenu : NSMenu
+@property (nonatomic) NSInteger topIndex;
+@end
+
+@implementation WineProgramMenu
+    - (BOOL) performKeyEquivalent:(NSEvent*)event
+    {
+        return NO;
+    }
+@end
+
+@interface WineProgramMenuController : NSObject <NSMenuDelegate>
+{
+    NSMutableArray* topItems;
+    WineWindow* menuWindow;
+    int retries;
+}
++ (WineProgramMenuController*) sharedController;
+- (void) windowBecameKey:(WineWindow*)window;
+@end
+
+@implementation WineProgramMenuController
+
+    + (WineProgramMenuController*) sharedController
+    {
+        static WineProgramMenuController* shared;
+        if (!shared) shared = [[WineProgramMenuController alloc] init];
+        return shared;
+    }
+
+    - (id) init
+    {
+        if ((self = [super init])) topItems = [[NSMutableArray alloc] init];
+        return self;
+    }
+
+    /* Returns a retained array, or NULL on timeout/no menu. */
+    - (CFArrayRef) copySnapshotFor:(WineWindow*)window top:(int)top
+    {
+        macdrv_query* query = macdrv_create_query();
+        CFArrayRef items = NULL;
+
+        query->type = QUERY_MENU_SNAPSHOT;
+        query->window = [window retain];
+        query->menu.top = top;
+        query->menu.items = NULL;
+        if ([window.queue query:query timeout:0.3])
+        {
+            items = query->menu.items;
+            query->menu.items = NULL;
+        }
+        macdrv_release_query(query);
+        return items;
+    }
+
+    static void apply_shortcut(NSMenuItem* item, NSString* text)
+    {
+        NSEventModifierFlags mods = 0;
+        NSString* key = nil;
+        NSCharacterSet* ws = [NSCharacterSet whitespaceCharacterSet];
+        unichar c;
+
+        for (NSString* raw in [text componentsSeparatedByString:@"+"])
+        {
+            NSString* part = [[raw stringByTrimmingCharactersInSet:ws] lowercaseString];
+            if (![part length]) continue;
+            if ([part isEqualToString:@"ctrl"] || [part isEqualToString:@"control"] || [part isEqualToString:@"strg"])
+                mods |= NSEventModifierFlagCommand;  /* Command acts as Ctrl */
+            else if ([part isEqualToString:@"shift"] || [part isEqualToString:@"umschalt"])
+                mods |= NSEventModifierFlagShift;
+            else if ([part isEqualToString:@"alt"])
+                mods |= NSEventModifierFlagOption;
+            else
+                key = part;
+        }
+        if (!key) return;
+
+        if ([key length] == 1)
+            ;
+        else if ([key characterAtIndex:0] == 'f' && [[key substringFromIndex:1] intValue] >= 1 &&
+                 [[key substringFromIndex:1] intValue] <= 24)
+        {
+            c = NSF1FunctionKey + [[key substringFromIndex:1] intValue] - 1;
+            key = [NSString stringWithCharacters:&c length:1];
+        }
+        else if ([key isEqualToString:@"del"] || [key isEqualToString:@"delete"] || [key isEqualToString:@"entf"])
+        {
+            c = NSDeleteFunctionKey;
+            key = [NSString stringWithCharacters:&c length:1];
+        }
+        else if ([key isEqualToString:@"tab"]) key = @"\t";
+        else if ([key isEqualToString:@"enter"] || [key isEqualToString:@"return"]) key = @"\r";
+        else if ([key isEqualToString:@"esc"]) key = @"\e";
+        else if ([key isEqualToString:@"space"]) key = @" ";
+        else return;
+
+        item.keyEquivalent = key;
+        item.keyEquivalentModifierMask = mods;
+    }
+
+    - (void) fillMenu:(NSMenu*)menu withItems:(NSArray*)items
+    {
+        [menu removeAllItems];
+        menu.autoenablesItems = NO;
+        for (NSDictionary* dict in items)
+        {
+            int flags = [dict[@"f"] intValue];
+            NSString* title = dict[@"t"];
+            NSArray* sub = dict[@"s"];
+            NSMenuItem* item;
+
+            if (flags & PROGRAM_MENU_SEPARATOR)
+            {
+                if ([menu numberOfItems] && ![[menu itemAtIndex:[menu numberOfItems] - 1] isSeparatorItem])
+                    [menu addItem:[NSMenuItem separatorItem]];
+                continue;
+            }
+            if (![title length]) continue;  /* owner-drawn / bitmap-only items */
+
+            item = [[[NSMenuItem alloc] initWithTitle:title action:NULL keyEquivalent:@""] autorelease];
+            item.enabled = !(flags & PROGRAM_MENU_DISABLED);
+            item.state = (flags & PROGRAM_MENU_CHECKED) ? NSControlStateValueOn : NSControlStateValueOff;
+            if (sub)
+            {
+                WineProgramMenu* submenu = [[[WineProgramMenu alloc] initWithTitle:title] autorelease];
+                submenu.topIndex = -1;
+                [self fillMenu:submenu withItems:sub];
+                item.submenu = submenu;
+            }
+            else
+            {
+                item.target = self;
+                item.action = @selector(itemSelected:);
+                item.tag = [dict[@"i"] unsignedIntValue];
+                if (dict[@"k"]) apply_shortcut(item, dict[@"k"]);
+            }
+            [menu addItem:item];
+        }
+    }
+
+    - (void) removeProgramMenus
+    {
+        NSMenu* mainMenu = [NSApp mainMenu];
+        for (NSMenuItem* item in topItems)
+            if ([mainMenu indexOfItem:item] >= 0) [mainMenu removeItem:item];
+        [topItems removeAllObjects];
+        [menuWindow release];
+        menuWindow = nil;
+    }
+
+    - (void) windowBecameKey:(WineWindow*)window
+    {
+        NSMenu* mainMenu = [NSApp mainMenu];
+        CFArrayRef items;
+        NSInteger i;
+
+        if (!native_menubar || !window || !mainMenu) return;
+
+        items = [self copySnapshotFor:window top:-1];
+        if (!items || !CFArrayGetCount(items))
+        {
+            /* Dialogs have no menu: keep the main window's. A brand-new window may not
+               have its menu yet, so try again shortly. */
+            if (items) CFRelease(items);
+            if (window != menuWindow && retries++ < 3)
+            {
+                [window retain];
+                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 700 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+                    if ([window isKeyWindow]) [self windowBecameKey:window];
+                    [window release];
+                });
+            }
+            return;
+        }
+        retries = 0;
+
+        [self removeProgramMenus];
+        menuWindow = [window retain];
+        i = 0;
+        for (NSDictionary* dict in (NSArray*)items)
+        {
+            NSString* title = dict[@"t"];
+            NSMenuItem* top;
+            WineProgramMenu* submenu;
+
+            if (![title length] || !dict[@"s"]) { i++; continue; }
+            submenu = [[[WineProgramMenu alloc] initWithTitle:title] autorelease];
+            submenu.topIndex = i;
+            submenu.delegate = self;
+            [self fillMenu:submenu withItems:dict[@"s"]];
+            top = [[[NSMenuItem alloc] initWithTitle:title action:NULL keyEquivalent:@""] autorelease];
+            top.submenu = submenu;
+            [mainMenu insertItem:top atIndex:1 + [topItems count]];
+            [topItems addObject:top];
+            i++;
+        }
+        CFRelease(items);
+    }
+
+    /* NSMenuDelegate: refresh a top-level menu right before it opens */
+    - (void) menuNeedsUpdate:(NSMenu*)menu
+    {
+        CFArrayRef items;
+
+        if (![menu isKindOfClass:[WineProgramMenu class]] || ((WineProgramMenu*)menu).topIndex < 0 || !menuWindow)
+            return;
+        items = [self copySnapshotFor:menuWindow top:(int)((WineProgramMenu*)menu).topIndex];
+        if (!items) return;  /* program busy: keep the previous contents */
+        [self fillMenu:menu withItems:(NSArray*)items];
+        CFRelease(items);
+    }
+
+    - (void) itemSelected:(NSMenuItem*)sender
+    {
+        macdrv_query* query;
+
+        if (!menuWindow) return;
+        query = macdrv_create_query();
+        query->type = QUERY_MENU_COMMAND;
+        query->window = [menuWindow retain];
+        query->menu.command = (unsigned int)sender.tag;
+        [menuWindow.queue query:query timeout:0.3];
+        macdrv_release_query(query);
+    }
+
+@end
+
+void macdrv_program_menu_window_became_key(WineWindow* window)
+{
+    if (native_menubar) [[WineProgramMenuController sharedController] windowBecameKey:window];
+}
