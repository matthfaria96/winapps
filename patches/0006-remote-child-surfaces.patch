diff -ruN pa/dlls/winemac.drv/surface.c pb/dlls/winemac.drv/surface.c
--- a/dlls/winemac.drv/surface.c	2026-11-07 14:02:07
+++ b/dlls/winemac.drv/surface.c	2026-11-07 15:22:28
@@ -26,6 +26,7 @@
 
 #include "config.h"
 #include "macdrv.h"
+#include "wine/list.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(bitblt);
 
@@ -222,6 +223,378 @@
 
 
 /***********************************************************************
+ *              Remote surfaces
+ *
+ * A child window whose top-level window belongs to another process (e.g. the
+ * WebView2/Chromium windows embedded in an application window) cannot be attached
+ * to that process' Cocoa window. Its content is put in a CAContext instead, whose
+ * layers the process owning the top-level shows with a CALayerHost (the same
+ * mechanism Chromium and WebKit use on macOS). A small shared file announces the
+ * context id and where the child is: <dir>/<child hwnd>-<serial>.surf.
+ */
+#include <sys/mman.h>
+#include <pthread.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+#define REMOTE_SURFACE_MAGIC 0x53524d57 /* 'WMRS' */
+
+struct remote_surface_header
+{
+    unsigned int  magic;
+    unsigned int  version;
+    volatile unsigned int seq;      /* incremented on every change */
+    unsigned int  visible;
+    int           x, y;             /* relative to the root window's client area (raw pixels) */
+    int           width, height;
+    unsigned int  context_id;       /* CAContext id to show with a CALayerHost */
+    unsigned int  kind;             /* 0: window surface (GDI), 1: client surface (GPU) */
+    unsigned int  pid;              /* producer, to drop files of dead processes */
+    unsigned int  frames;           /* number of images presented (diagnostics) */
+    unsigned int  pad[4];
+};
+
+struct remote_header
+{
+    struct remote_surface_header *shared;
+    char path[512];
+};
+
+int macdrv_remote_surface_dir(char *buf, size_t size, void *root_hwnd)
+{
+    const char *tmp = getenv("TMPDIR"), *prefix = getenv("WINEPREFIX");
+    unsigned int hash = 5381;
+    const char *p;
+
+    if (!tmp || !*tmp) tmp = "/tmp";
+    for (p = prefix ? prefix : "default"; *p; p++) hash = hash * 33 + (unsigned char)*p;
+    if (root_hwnd)
+        return snprintf(buf, size, "%s/winemac-remote-%u-%08x/%08lx", tmp, (unsigned int)getuid(), hash,
+                        (unsigned long)(ULONG_PTR)root_hwnd);
+    return snprintf(buf, size, "%s/winemac-remote-%u-%08x", tmp, (unsigned int)getuid(), hash);
+}
+
+
+#include <stdarg.h>
+/* desenvolvimento: WINEMAC_DEBUG_LOG=<arquivo> */
+void macdrv_dbg(const char *fmt, ...)
+{
+    static FILE *f; const char *p = getenv("WINEMAC_DEBUG_LOG"); va_list ap;
+    if (!p) return;
+    if (!f && !(f = fopen(p, "a"))) return;
+    fprintf(f, "[pid %d] ", (int)getpid());
+    va_start(ap, fmt); vfprintf(f, fmt, ap); va_end(ap); fflush(f);
+}
+
+bool macdrv_is_remote_root_child(HWND hwnd)
+{
+    DWORD pid = 0;
+    HWND root = NtUserGetAncestor(hwnd, GA_ROOT);
+
+    if (!root || root == hwnd) return FALSE;
+    NtUserGetWindowThread(root, &pid);
+    return pid && pid != GetCurrentProcessId();
+}
+
+static void remote_header_update(struct remote_header *hdr, HWND hwnd)
+{
+    HWND root = NtUserGetAncestor(hwnd, GA_ROOT);
+    UINT dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+    POINT origin = {0, 0};
+    RECT rect;
+
+    if (!hdr->shared) return;
+    /* the client area, relative to the root's client area (what its Cocoa content view shows) */
+    if (!NtUserGetClientRect(hwnd, &rect, dpi)) return;
+    NtUserMapWindowPoints(hwnd, 0, (POINT *)&rect, 2, dpi);
+    NtUserMapWindowPoints(root, 0, &origin, 1, dpi);
+    hdr->shared->x = rect.left - origin.x;
+    hdr->shared->y = rect.top - origin.y;
+    hdr->shared->width = rect.right - rect.left;
+    hdr->shared->height = rect.bottom - rect.top;
+    hdr->shared->visible = NtUserIsWindowVisible(hwnd);
+    __atomic_add_fetch(&hdr->shared->seq, 1, __ATOMIC_RELEASE);
+}
+
+static BOOL remote_header_create(struct remote_header *hdr, HWND hwnd, unsigned int kind, unsigned int context_id)
+{
+    static LONG serial;
+    char dir[480];
+    int fd;
+
+    macdrv_remote_surface_dir(dir, sizeof(dir), NULL);
+    mkdir(dir, 0700);
+    macdrv_remote_surface_dir(dir, sizeof(dir), NtUserGetAncestor(hwnd, GA_ROOT));
+    mkdir(dir, 0700);
+    snprintf(hdr->path, sizeof(hdr->path), "%s/%08lx-%08x.surf", dir, (unsigned long)(ULONG_PTR)hwnd,
+             (unsigned int)InterlockedIncrement(&serial));
+
+    if ((fd = open(hdr->path, O_RDWR | O_CREAT | O_TRUNC, 0600)) < 0) return FALSE;
+    if (ftruncate(fd, sizeof(*hdr->shared)) ||
+        (hdr->shared = mmap(NULL, sizeof(*hdr->shared), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0)) == MAP_FAILED)
+    {
+        hdr->shared = NULL;
+        close(fd);
+        unlink(hdr->path);
+        return FALSE;
+    }
+    close(fd);
+    hdr->shared->version = 2;
+    hdr->shared->kind = kind;
+    hdr->shared->context_id = context_id;
+    hdr->shared->pid = getpid();
+    remote_header_update(hdr, hwnd);
+    __atomic_store_n(&hdr->shared->magic, REMOTE_SURFACE_MAGIC, __ATOMIC_RELEASE);
+    TRACE("hwnd %p kind %u context %u -> %s\n", hwnd, kind, context_id, debugstr_a(hdr->path));
+    return TRUE;
+}
+
+static void remote_header_destroy(struct remote_header *hdr)
+{
+    if (hdr->shared) munmap(hdr->shared, sizeof(*hdr->shared));
+    if (hdr->path[0]) unlink(hdr->path);
+    hdr->shared = NULL;
+    hdr->path[0] = 0;
+}
+
+/* client surfaces (OpenGL/Vulkan/D3D) of remote root children: share the view's layers */
+void macdrv_remote_client_surface_init(struct macdrv_client_surface *surface)
+{
+    struct remote_header *hdr;
+    unsigned int context_id = 0;
+
+    if (!(hdr = calloc(1, sizeof(*hdr)))) return;
+    if (!(surface->remote_context = macdrv_remote_context_create(surface->cocoa_view, &context_id)) ||
+        !remote_header_create(hdr, surface->client.hwnd, 1, context_id))
+    {
+        if (surface->remote_context) macdrv_remote_context_release(surface->remote_context);
+        surface->remote_context = NULL;
+        free(hdr);
+        return;
+    }
+    surface->remote = hdr;
+}
+
+void macdrv_remote_client_surface_presented(struct macdrv_client_surface *surface)
+{
+    if (surface->remote && surface->remote->shared)
+        __atomic_add_fetch(&surface->remote->shared->frames, 1, __ATOMIC_RELAXED);
+}
+
+void macdrv_remote_client_surface_update(struct macdrv_client_surface *surface)
+{
+    if (surface->remote) remote_header_update(surface->remote, surface->client.hwnd);
+}
+
+void macdrv_remote_client_surface_destroy(struct macdrv_client_surface *surface)
+{
+    if (surface->remote)
+    {
+        remote_header_destroy(surface->remote);
+        free(surface->remote);
+        surface->remote = NULL;
+    }
+    if (surface->remote_context) macdrv_remote_context_release(surface->remote_context);
+    surface->remote_context = NULL;
+}
+
+
+/* standalone CAMetalLayers for DXMT swapchains of remote root children
+ * (a view-backed layer outside any window is not updated by AppKit) */
+struct remote_metal
+{
+    struct list           entry;
+    HWND                  hwnd;
+    void                 *context;   /* CAContext */
+    void                 *layer;     /* CAMetalLayer */
+    struct remote_header  hdr;
+};
+
+static struct list remote_metals = LIST_INIT(remote_metals);
+static pthread_mutex_t remote_metals_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static CGRect remote_client_rect(HWND hwnd)
+{
+    RECT rect = {0};
+    NtUserGetClientRect(hwnd, &rect, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI));
+    return cgrect_from_rect(rect);
+}
+
+void *macdrv_remote_metal_create(HWND hwnd, void *device)
+{
+    struct remote_metal *rm;
+    unsigned int context_id = 0;
+
+    if (!(rm = calloc(1, sizeof(*rm)))) return NULL;
+    rm->hwnd = hwnd;
+    if (!(rm->context = macdrv_remote_metal_layer_create(device, remote_client_rect(hwnd), &context_id, &rm->layer)))
+    {
+        free(rm);
+        return NULL;
+    }
+    remote_header_create(&rm->hdr, hwnd, 1, context_id);
+    pthread_mutex_lock(&remote_metals_mutex);
+    list_add_tail(&remote_metals, &rm->entry);
+    pthread_mutex_unlock(&remote_metals_mutex);
+    macdrv_dbg("remote metal hwnd %p context %u layer %p\n", hwnd, context_id, rm->layer);
+    return (void *)((ULONG_PTR)rm | 1);
+}
+
+void *macdrv_remote_metal_layer(void *handle)
+{
+    struct remote_metal *rm = (struct remote_metal *)((ULONG_PTR)handle & ~(ULONG_PTR)1);
+    return rm->layer;
+}
+
+void macdrv_remote_metal_release(void *handle)
+{
+    struct remote_metal *rm = (struct remote_metal *)((ULONG_PTR)handle & ~(ULONG_PTR)1);
+
+    pthread_mutex_lock(&remote_metals_mutex);
+    list_remove(&rm->entry);
+    pthread_mutex_unlock(&remote_metals_mutex);
+    remote_header_destroy(&rm->hdr);
+    macdrv_remote_context_release(rm->context);  /* also releases the layer */
+    free(rm);
+}
+
+void macdrv_remote_metal_update(HWND hwnd)
+{
+    struct remote_metal *rm;
+
+    pthread_mutex_lock(&remote_metals_mutex);
+    LIST_FOR_EACH_ENTRY(rm, &remote_metals, struct remote_metal, entry)
+    {
+        if (rm->hwnd != hwnd) continue;
+        remote_header_update(&rm->hdr, hwnd);
+        macdrv_remote_metal_layer_resize(rm->context, remote_client_rect(hwnd));
+    }
+    pthread_mutex_unlock(&remote_metals_mutex);
+}
+
+/* window surfaces (GDI) of remote root children: the image goes to a shared layer */
+struct macdrv_remote_surface
+{
+    struct window_surface   header;
+    CGDataProviderRef       provider;
+    void                   *context;
+    struct remote_header    remote;
+};
+
+static const struct window_surface_funcs remote_surface_funcs;
+
+static struct macdrv_remote_surface *get_remote_surface(struct window_surface *surface)
+{
+    if (!surface || surface->funcs != &remote_surface_funcs) return NULL;
+    return (struct macdrv_remote_surface *)surface;
+}
+
+static void remote_surface_set_clip(struct window_surface *window_surface, const RECT *rects, UINT count)
+{
+}
+
+static BOOL remote_surface_flush(struct window_surface *window_surface, const RECT *rect, const RECT *dirty,
+                                 const BITMAPINFO *color_info, const void *color_bits, BOOL shape_changed,
+                                 const BITMAPINFO *shape_info, const void *shape_bits)
+{
+    struct macdrv_remote_surface *surface = get_remote_surface(window_surface);
+    CGColorSpaceRef colorspace = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+    CGImageRef image;
+
+    image = CGImageCreate(color_info->bmiHeader.biWidth, abs(color_info->bmiHeader.biHeight), 8, 32,
+                          color_info->bmiHeader.biSizeImage / abs(color_info->bmiHeader.biHeight), colorspace,
+                          kCGImageAlphaNoneSkipFirst | kCGBitmapByteOrder32Little, surface->provider, NULL,
+                          retina_on, kCGRenderingIntentDefault);
+    CGColorSpaceRelease(colorspace);
+    macdrv_remote_context_set_image(surface->context, image, cgrect_from_rect(*rect));
+    CGImageRelease(image);
+    if (surface->remote.shared) __atomic_add_fetch(&surface->remote.shared->frames, 1, __ATOMIC_RELAXED);
+    return TRUE;
+}
+
+static void remote_surface_destroy(struct window_surface *window_surface)
+{
+    struct macdrv_remote_surface *surface = get_remote_surface(window_surface);
+
+    TRACE("freeing %p\n", surface);
+    remote_header_destroy(&surface->remote);
+    if (surface->context) macdrv_remote_context_release(surface->context);
+    CGDataProviderRelease(surface->provider);
+}
+
+static const struct window_surface_funcs remote_surface_funcs =
+{
+    .size = sizeof(struct macdrv_remote_surface),
+    .set_clip = remote_surface_set_clip,
+    .flush = remote_surface_flush,
+    .destroy = remote_surface_destroy,
+};
+
+static struct window_surface *create_remote_surface(HWND hwnd, const RECT *rect)
+{
+    int width = rect->right - rect->left, height = rect->bottom - rect->top;
+    D3DKMT_CREATEDCFROMMEMORY desc = {.Format = D3DDDIFMT_A8R8G8B8};
+    char buffer[FIELD_OFFSET(BITMAPINFO, bmiColors[256])];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    struct window_surface *window_surface;
+    struct macdrv_remote_surface *surface;
+    unsigned int context_id = 0;
+    CGDataProviderRef provider;
+    HBITMAP bitmap = 0;
+    void *bits, *context;
+
+    memset(info, 0, sizeof(*info));
+    info->bmiHeader.biSize        = sizeof(info->bmiHeader);
+    info->bmiHeader.biWidth       = width;
+    info->bmiHeader.biHeight      = -height; /* top-down */
+    info->bmiHeader.biPlanes      = 1;
+    info->bmiHeader.biBitCount    = 32;
+    info->bmiHeader.biSizeImage   = get_dib_image_size(info);
+    info->bmiHeader.biCompression = BI_RGB;
+
+    if (!(context = macdrv_remote_context_create(NULL, &context_id))) return NULL;
+    if (!(provider = data_provider_create(info->bmiHeader.biSizeImage, &bits)))
+    {
+        macdrv_remote_context_release(context);
+        return NULL;
+    }
+    memset(bits, 0xff, info->bmiHeader.biSizeImage);
+
+    desc.Width = width;
+    desc.Height = height;
+    desc.Pitch = info->bmiHeader.biSizeImage / height;
+    desc.pMemory = bits;
+    desc.hDeviceDc = NtUserGetDCEx(hwnd, 0, DCX_CACHE | DCX_WINDOW);
+    if (NtGdiDdDDICreateDCFromMemory(&desc)) ERR("Failed to create HBITMAP\n");
+    else
+    {
+        bitmap = desc.hBitmap;
+        NtGdiDeleteObjectApp(desc.hDc);
+    }
+    if (desc.hDeviceDc) NtUserReleaseDC(hwnd, desc.hDeviceDc);
+
+    if (!(window_surface = window_surface_create(&remote_surface_funcs, hwnd, rect, info, bitmap)))
+    {
+        if (bitmap) NtGdiDeleteObjectApp(bitmap);
+        CGDataProviderRelease(provider);
+        macdrv_remote_context_release(context);
+        return NULL;
+    }
+    surface = get_remote_surface(window_surface);
+    surface->provider = provider;
+    surface->context = context;
+    remote_header_create(&surface->remote, hwnd, 0, context_id);
+    return window_surface;
+}
+
+void macdrv_remote_surface_update(HWND hwnd, struct window_surface *window_surface)
+{
+    struct macdrv_remote_surface *surface = get_remote_surface(window_surface);
+    if (surface) remote_header_update(&surface->remote, hwnd);
+}
