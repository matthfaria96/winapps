+/*
+ * ---------- Remote surfaces (see surface.c) ----------
+ *
+ * Producer side: a CAContext whose layer tree the window server can show in any
+ * process. Owner side: a CALayerHost per child window of ours that belongs to
+ * another process, placed over that child's area. Same mechanism as Chromium/WebKit.
+ */
+@interface CAContext : NSObject
++ (id) contextWithCGSConnection:(unsigned int)connection options:(NSDictionary *)options;
+@property (readonly) unsigned int contextId;
+@property (retain) CALayer *layer;
+@end
+
+@interface CALayerHost : CALayer
+@property unsigned int contextId;
+@end
+
+static unsigned int window_server_connection(void)
+{
+    static unsigned int (*pCGSMainConnectionID)(void);
+    if (!pCGSMainConnectionID) pCGSMainConnectionID = dlsym(RTLD_DEFAULT, "CGSMainConnectionID");
+    return pCGSMainConnectionID ? pCGSMainConnectionID() : 0;
+}
+
+void *macdrv_remote_context_create(WineContentView *view, unsigned int *context_id)
+{
+    __block CAContext *context = nil;
+    __block unsigned int cid = 0;
+
+    OnMainThread(^{
+        Class cls = NSClassFromString(@"CAContext");
+        CALayer *layer;
+        if (!cls) return;
+        if (view)
+        {
+            [view setWantsLayer:YES];
+            layer = [view layer];
+        }
+        else
+        {
+            layer = [CALayer layer];
+            layer.anchorPoint = CGPointZero;
+            layer.contentsGravity = kCAGravityTopLeft;
+        }
+        context = [[cls contextWithCGSConnection:window_server_connection() options:@{}] retain];
+        context.layer = layer;
+        cid = context.contextId;
+    });
+    *context_id = cid;
+    return context;
+}
+
+void macdrv_remote_context_set_image(void *ctx, CGImageRef image, CGRect rect)
+{
+    CAContext *context = ctx;
+    if (!context) return;
+    CGImageRetain(image);
+    OnMainThreadAsync(^{
+        CGRect frame = cgrect_mac_from_win(rect);
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        context.layer.bounds = CGRectMake(0, 0, frame.size.width, frame.size.height);
+        context.layer.position = CGPointZero;
+        context.layer.contentsScale = retina_on ? 2.0 : 1.0;
+        context.layer.contents = (id)image;
+        [CATransaction commit];
+        CGImageRelease(image);
+    });
+}
+
+void *macdrv_remote_metal_layer_create(void *device, CGRect rect, unsigned int *context_id, void **layer_out)
+{
+    __block CAContext *context = nil;
+    __block CALayer *metal = nil;
+    __block unsigned int cid = 0;
+
+    OnMainThread(^{
+        Class cls = NSClassFromString(@"CAContext");
+        CALayer *root;
+        CGRect frame = cgrect_mac_from_win(rect);
+        if (!cls) return;
+        root = [CALayer layer];
+        root.anchorPoint = CGPointZero;
+        root.bounds = CGRectMake(0, 0, frame.size.width, frame.size.height);
+        metal = [[NSClassFromString(@"CAMetalLayer") alloc] init];
+        [metal setValue:(id)device forKey:@"device"];
+        metal.anchorPoint = CGPointZero;
+        metal.position = CGPointZero;
+        metal.bounds = root.bounds;
+        metal.contentsScale = retina_on ? 2.0 : 1.0;
+        metal.opaque = YES;
+        [root addSublayer:metal];
+        context = [[cls contextWithCGSConnection:window_server_connection() options:@{}] retain];
+        context.layer = root;
+        cid = context.contextId;
+    });
+    *context_id = cid;
+    *layer_out = metal;  /* owned by the context's root; released with it */
+    if (metal) [metal release];
+    return context;
+}
+
+void macdrv_remote_metal_layer_resize(void *ctx, CGRect rect)
+{
+    CAContext *context = ctx;
+    if (!context) return;
+    OnMainThreadAsync(^{
+        CGRect frame = cgrect_mac_from_win(rect);
+        CGRect bounds = CGRectMake(0, 0, frame.size.width, frame.size.height);
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        context.layer.bounds = bounds;
+        for (CALayer *sub in context.layer.sublayers) sub.bounds = bounds;
+        [CATransaction commit];
+    });
+}
+
+void macdrv_remote_context_release(void *ctx)
+{
+    CAContext *context = ctx;
+    if (!context) return;
+    OnMainThreadAsync(^{
+        context.layer = nil;
+        [context release];
+    });
+}
+
+struct remote_surface_header_view
+{
+    unsigned int  magic, version, seq, visible;
+    int           x, y, width, height;
+    unsigned int  context_id, kind, pid, pad[5];
+};
+
+@interface WineRemoteLayer : NSObject
+{
+@public
+    CALayer *container;
+    CALayerHost *host;
+    void *map;
+    unsigned int seq;
+}
+@end
+
+@implementation WineRemoteLayer
+    - (void) dealloc
+    {
+        if (map) munmap(map, sizeof(struct remote_surface_header_view));
+        [container removeFromSuperlayer];
+        [container release];
+        [host release];
+        [super dealloc];
+    }
+@end
+
+static NSMutableDictionary *remote_layers;
+
+static void remote_surfaces_poll(void)
+{
+    char base[512], dir[512];
+    struct stat st;
+    NSMutableSet *seen;
+
+    macdrv_remote_surface_dir(base, sizeof(base), NULL);
+    if (stat(base, &st))
+    {
+        if ([remote_layers count]) [remote_layers removeAllObjects];
+        return;
+    }
+
+    seen = [NSMutableSet set];
+    for (NSWindow *w in [NSApp windows])
+    {
+        NSArray *files;
+        NSView *view;
+
+        if (![w isKindOfClass:[WineWindow class]]) continue;
+        macdrv_remote_surface_dir(dir, sizeof(dir), macdrv_get_window_hwnd((WineWindow *)w));
+        files = [[NSFileManager defaultManager] contentsOfDirectoryAtPath:[NSString stringWithUTF8String:dir] error:NULL];
+        if (![files count]) continue;
+        view = [w contentView];
+
+        for (NSString *f in files)
+        {
+            NSString *ident = [NSString stringWithFormat:@"%s/%@", dir, f];
+            WineRemoteLayer *r = remote_layers[ident];
+            struct remote_surface_header_view *h;
+            unsigned int seq;
+
+            if (![f hasSuffix:@".surf"]) continue;
+            if (!r)
+            {
+                int fd = open([ident fileSystemRepresentation], O_RDONLY);
+                void *map;
+                if (fd < 0) continue;
+                map = mmap(NULL, sizeof(*h), PROT_READ, MAP_SHARED, fd, 0);
+                close(fd);
+                if (map == MAP_FAILED) continue;
+                r = [[[WineRemoteLayer alloc] init] autorelease];
+                r->map = map;
+                r->seq = ~0u;
+                remote_layers[ident] = r;
+            }
+            h = r->map;
+            if (__atomic_load_n(&h->magic, __ATOMIC_ACQUIRE) != 0x53524d57) { [seen addObject:ident]; continue; }
+            if (h->pid && kill(h->pid, 0) && errno == ESRCH)
+            {
+                unlink([ident fileSystemRepresentation]);  /* left behind by a dead process */
+                continue;
+            }
+            [seen addObject:ident];
+            seq = __atomic_load_n(&h->seq, __ATOMIC_ACQUIRE);
+            if (seq == r->seq && r->container.superlayer == view.layer) continue;
+            r->seq = seq;
+
+            if (![view wantsLayer]) [view setWantsLayer:YES];
+            if (!r->container)
+            {
+                r->container = [[CALayer alloc] init];
+                r->container.anchorPoint = CGPointZero;
+                r->container.masksToBounds = YES;
+                r->host = [[NSClassFromString(@"CALayerHost") alloc] init];
+                r->host.anchorPoint = CGPointZero;
+                [r->container addSublayer:r->host];
+            }
+            if (r->container.superlayer != view.layer) [view.layer addSublayer:r->container];
+
+            [CATransaction begin];
+            [CATransaction setDisableActions:YES];
+            {
+                CGRect frame = cgrect_mac_from_win(CGRectMake(h->x, h->y, h->width, h->height));
+                if (r->host.contextId != h->context_id) r->host.contextId = h->context_id;
+                r->container.zPosition = 1000 + h->kind;   /* GPU content above GDI content */
+                r->container.hidden = !h->visible || !h->context_id;
+                r->container.position = frame.origin;
+                r->container.bounds = CGRectMake(0, 0, frame.size.width, frame.size.height);
+                r->host.position = CGPointZero;
+            }
+            [CATransaction commit];
+        }
+    }
+
+    for (NSString *ident in [remote_layers allKeys])
+        if (![seen containsObject:ident]) [remote_layers removeObjectForKey:ident];
+}
+
+void macdrv_remote_surfaces_start(void)
+{
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        dispatch_source_t timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
+        remote_layers = [[NSMutableDictionary alloc] init];
+        dispatch_source_set_timer(timer, DISPATCH_TIME_NOW, NSEC_PER_SEC / 60, NSEC_PER_MSEC * 4);
+        dispatch_source_set_event_handler(timer, ^{
+            @autoreleasepool { remote_surfaces_poll(); }
+        });
+        dispatch_resume(timer);
+    });
 }
