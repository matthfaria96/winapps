cmd_env() {  # imprime as variáveis de ambiente (usado pelos atalhos)
    require_wine
    local v
    for v in WINEPREFIX WINEDEBUG WINEDLLOVERRIDES LANG PATH; do
        printf 'export %s=%q\n' "$v" "${!v}"
    done
    printf 'export WINESERVER=%q\n' "$WINESERVER"
    echo "unset LC_ALL"
}

cmd_rebuild() {  # recria todos os atalhos (ex.: depois de atualizar o motor)
    local a exe pfx
    for a in "$APPS_DIR"/*.app; do
        exe="$(/usr/libexec/PlistBuddy -c 'Print :WinAppsExe' "$a/Contents/Info.plist" 2>/dev/null)" || continue
        # cada atalho volta para o seu próprio ambiente (atalhos antigos: deduz pelo caminho)
        pfx="$(/usr/libexec/PlistBuddy -c 'Print :WinAppsPrefix' "$a/Contents/Info.plist" 2>/dev/null)" \
            || pfx="${exe%%/drive_c/*}"
        [ -f "$exe" ] && ( PREFIX="$pfx"; cmd_shortcut "$exe" "$(basename "$a" .app)" )
    done
}

cmd_list() {
    local a found=0
    for a in "$APPS_DIR"/*.app; do
        [ -f "$a/Contents/Info.plist" ] || continue
        local exe; exe="$(/usr/libexec/PlistBuddy -c 'Print :WinAppsExe' "$a/Contents/Info.plist" 2>/dev/null)" || continue
        printf '%-28s %s\n' "$(basename "$a" .app)" "$exe"; found=1
    done
    [ $found = 1 ] || echo "$(t 'No shortcuts yet.' 'Nenhum atalho criado ainda.')"
}

cmd_remove() {
    [ $# -ge 1 ] || die "$(t 'usage: winapps remove <App name>' 'uso: winapps remove <Nome do app>')"
    local app="$APPS_DIR/$1.app"
    /usr/libexec/PlistBuddy -c 'Print :WinAppsExe' "$app/Contents/Info.plist" >/dev/null 2>&1 \
        || die "'$1' $(t "isn't a WinApps shortcut" 'não é um atalho do WinApps')"
    rm -rf "$app"; say "$(t 'Shortcut removed (the program is still installed in the Windows environment).' 'Atalho removido (o programa continua instalado no ambiente Windows).')"
}

# Apaga o que é descartável: temporários do Windows (ex.: o Power BI deixa ~1 GB em Temp) e
# os downloads em cache (baixados de novo se precisar). Só com os programas fechados.
# --temp: só os temporários (o app faz isso sozinho ao abrir, em silêncio).
# processos dos atalhos do WinApps abertos (só os nossos: Info.plist com WinAppsExe)
shortcut_pids() {
    local a n
    for a in "$APPS_DIR"/*.app; do
        /usr/libexec/PlistBuddy -c 'Print :WinAppsExe' "$a/Contents/Info.plist" >/dev/null 2>&1 || continue
        n="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$a/Contents/Info.plist" 2>/dev/null)"
        pgrep -f "^$(printf '%s' "$a/Contents/MacOS/$n" | sed 's/[][\.*^$+?(){}|]/\\&/g')" 2>/dev/null
    done
}

cmd_clean() {
    local only_temp=0 force=0
    case "${1:-}" in --temp) only_temp=1 ;; --force) force=1 ;; esac
    local sys='\\(services|winedevice|explorer|plugplay|svchost|rpcss|conhost|start|wineboot|tabtip|mscorsvw|lsass)\.exe'
    local busy=0
    if [ -n "$(shortcut_pids)" ] || \
       ps -axo command | grep -iE '^([a-z]:\\|/Users/.*/drive_c/)' | grep -viE "$sys" | grep -q .; then
        busy=1
    fi
    if [ "$busy" = 1 ]; then
        [ "$force" = 1 ] || die "$(t 'quit the open Windows programs before freeing up space' 'feche os programas Windows abertos antes de liberar espaço')"
        # domínio total: fecha à força tudo o que roda no ambiente antes de limpar
        require_wine
        "$WINESERVER" -k 2>/dev/null
        local p; for p in $(shortcut_pids); do kill -9 "$p" 2>/dev/null; done
        "$WINESERVER" -w 2>/dev/null
        /bin/sleep 1
        say "$(t 'Windows programs closed.' 'Programas Windows fechados.')"
    fi
    local d before after
    before="$(du -sk "$PREFIX/drive_c" 2>/dev/null | awk '{print $1}')"
    for d in "$PREFIX"/drive_c/users/*/AppData/Local/Temp "$PREFIX"/drive_c/users/*/Temp "$PREFIX/drive_c/windows/temp"; do
        [ -d "$d" ] && [ ! -L "$d" ] && find "$d" -mindepth 1 -delete 2>/dev/null
    done
    local dl="$HOME/Library/Caches/WinApps/downloads"
    [ "$only_temp" = 0 ] && [ -d "$dl" ] && find "$dl" -mindepth 1 -delete 2>/dev/null
    after="$(du -sk "$PREFIX/drive_c" 2>/dev/null | awk '{print $1}')"
    say "$(t 'Space freed:' 'Espaço liberado:') $(( (before - after) / 1024 )) MB $(t 'in the Windows environment, plus cached downloads.' 'no ambiente Windows, mais os downloads em cache.')"
}

cmd_config() { require_wine; "$WINE" winecfg >/dev/null 2>&1; }
cmd_kill()   { require_wine; "$WINESERVER" -k; say "$(t 'All Windows programs were closed.' 'Todos os programas Windows foram fechados.')"; }
