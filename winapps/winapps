  winapps menubar <prog.exe>|--all on|off  menu dos programas na barra de menus do Mac
  winapps titlebar <prog.exe>|--all on|off barra de título do Mac em programas com barra própria

Ambiente Windows: $PREFIX
EOF
}

case "${1:-help}" in
    setup)     shift; cmd_setup "$@" ;;
    run)       shift; cmd_run "$@" ;;
    install)   shift; cmd_install "$@" ;;
    shortcut)  shift; cmd_shortcut "$@" ;;
    list)      shift; cmd_list ;;
    remove)    shift; cmd_remove "$@" ;;
    config)    shift; cmd_config ;;
    kill)      shift; cmd_kill ;;
    clean)     shift; cmd_clean "$@" ;;
    adopt)     shift; cmd_adopt "$@" ;;
    import)    shift; cmd_import "$@" ;;
    components) shift; cmd_components "$@" ;;
    needs)     shift; cmd_needs "$@" ;;
    compat)    shift; cmd_compat "$@" ;;
    new-prefix) shift; cmd_new_prefix "$@" ;;
    engine-patch) shift; migrate_engine_dir; require_wine; install_engine_patches; brand_engine
                  [ -f "$BASE/.dxmt-off" ] || cmd_dxmt on >/dev/null 2>&1 || true ;;
    dxmt)      shift; cmd_dxmt "$@" ;;
    gamepad)   shift; cmd_gamepad "$@" ;;
    optimize)  shift; cmd_optimize "$@" ;;
    version)   shift; require_wine; "$WINE" --version 2>/dev/null | sed -E 's/^wine-//; s/ .*//' ;;
    env)       shift; cmd_env ;;
    menubar)   shift; cmd_menubar "$@" ;;
    titlebar)  shift; cmd_titlebar "$@" ;;
    rebuild)   shift; cmd_rebuild ;;
    tidy)      shift; configure_prefix; say "$(t 'Mac folders and language updated.' 'Pastas do Mac e idioma ajustados.')" ;;
    drive)     shift; cmd_drive ;;
    gui-open)  shift; cmd_gui_open "$@" ;;
    name)      shift; [ $# -ge 1 ] || die "$(t 'usage: winapps name <file.exe>' 'uso: winapps name <arquivo.exe>')"; app_name_for "$1" ;;
    detect)    shift; [ $# -ge 1 ] || die "$(t 'usage: winapps detect <file.exe>' 'uso: winapps detect <arquivo.exe>')"; detect_kind "$1" ;;
    *)         cmd_help ;;
esac
