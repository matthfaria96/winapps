# chamado pelo WinApps.app quando o usuário abre um .exe/.msi pelo Finder
cmd_gui_open() {
    if ! find_wine_bin >/dev/null; then
        gui_alert "WinApps" "$(t 'First time: WinApps will now set up the Windows environment (about 15 minutes).' \
                                 'Primeira vez: o ambiente Windows será preparado (~15 minutos).')"
        cmd_setup >"$LOG_DIR/setup.log" 2>&1 || { gui_alert "WinApps" "$(t 'Setup failed. See' 'Falha na instalação. Veja') $LOG_DIR/setup.log"; exit 1; }
    fi
    require_wine
    local f="$1"
    local kind why choice b1 b2 msg cancel
    IFS="$(printf '\t')" read -r kind why <<<"$(detect_kind "$f")"
    if [ "$kind" = "installer" ]; then
        msg="$(t "\"$(basename "$f")\" looks like an installer ($why)." \
                 "\"$(basename "$f")\" parece ser um INSTALADOR ($why).")"
        b1="$(t 'Just Run' 'Só executar')"; b2="$(t 'Install' 'Instalar')"
    else
        msg="$(t "\"$(basename "$f")\" looks like a portable program — it runs right away, no installation needed ($why)." \
                 "\"$(basename "$f")\" parece ser um programa PORTÁTIL — roda direto, sem instalar ($why).")"
        b1="$(t 'Run' 'Executar')"; b2="$(t 'Run and Create Shortcut' 'Executar e criar atalho')"
    fi
    cancel="$(t 'Cancel' 'Cancelar')"
    choice="$(/usr/bin/osascript - "$msg" "$b1" "$b2" "$cancel" 2>/dev/null <<'EOF'
on run argv
    activate
    set r to display dialog (item 1 of argv) with title "WinApps" ¬
        buttons {item 4 of argv, item 2 of argv, item 3 of argv} default button (item 3 of argv) cancel button (item 4 of argv)
    return button returned of r
end run
EOF
)" || exit 0

    # compara com os próprios rótulos (já no idioma da interface)
    if [ "$choice" = "$b1" ]; then
        cmd_run "$f"; return
    elif [ "$kind" != "installer" ] && [ "$choice" = "$b2" ]; then
        local dest; dest="$(adopt_portable "$f")"
        cmd_shortcut "$dest" >>"$LOG_DIR/install.log" 2>&1
        cmd_run "$dest"; return
    fi

    # Instalar: roda o instalador e oferece criar atalhos
    cmd_install "$f" >"$LOG_DIR/install.log" 2>&1 || {
        gui_alert "WinApps" "$(t 'The installation finished, but no new programs were found.' 'A instalação terminou, mas nenhum programa novo foi encontrado.')"
        return
    }
    # lista para escolha: mostra caminho relativo ao C:
    local items picked
    items="$(echo "$NEW_EXES" | sed "s|^$PREFIX/drive_c/|C:/|")"
    picked="$(/usr/bin/osascript - "$items" \
        "$(t 'Installation complete! Create a shortcut in Applications for:' 'Instalação concluída! Criar atalho em Aplicativos para:')" \
        "$(t 'Create Shortcut' 'Criar atalho')" "$(t 'Cancel' 'Cancelar')" 2>/dev/null <<'EOF'
on run argv
    activate
    set AppleScript's text item delimiters to linefeed
    set opts to text items of (item 1 of argv)
    set r to choose from list opts with title "WinApps" ¬
        with prompt (item 2 of argv) ¬
        default items {item 1 of opts} OK button name (item 3 of argv) cancel button name (item 4 of argv) ¬
        with multiple selections allowed
    if r is false then return ""
    set AppleScript's text item delimiters to linefeed
    return r as text
end run
EOF
)"
    [ -n "$picked" ] || return
    echo "$picked" | while IFS= read -r p; do
        [ -n "$p" ] && cmd_shortcut "$PREFIX/drive_c/${p#C:/}"
    done
    open "$APPS_DIR"
}

